# ── Banco de dados ───────────────────────────────────────────
# Local (padrão do projeto):
DATABASE_URL=file:../db/custom.db
# Na Vercel (serverless, só /tmp é gravável):
# DATABASE_URL=file:/tmp/custom.db

# ── SEO / Analytics (opcional) ───────────────────────────────
# URL canônica do site em produção (ex.: https://seudominio.com.br)
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 (ex.: G-1ABCD23EFG)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity (Project ID do painel clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=
# Google Search Console (código da meta tag de verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
